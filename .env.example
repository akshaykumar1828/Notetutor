# Copy to .env and fill in. Never commit .env.

# --- AI providers (free tiers) ---
# Groq: https://console.groq.com/keys (required)
GROQ_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey (optional backup)
GEMINI_API_KEY=

# --- Web app ---
# Any long random string (32+ characters) used to sign login tokens
JWT_SECRET=
# Optional: this e-mail becomes an admin when it registers
# (otherwise the first account registered is the admin)
ADMIN_EMAIL=

# --- Database ---
# MongoDB Atlas connection string, or leave empty and start the bundled
# local MongoDB with: docker compose --profile local-db up
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Limits (sized to the free AI tiers) ---
# MAX_UPLOAD_MB=10
# MAX_PDF_PAGES=10

# --- Voice (optional) ---
# NOTETUTOR_TTS_VOICE=af_heart     # af_heart, af_bella, am_michael, bf_emma, bm_george
# NOTETUTOR_SPEECH_SPEED=0.95
